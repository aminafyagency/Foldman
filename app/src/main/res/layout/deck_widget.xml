<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen deck: the player body in the current skin's colour, the cover in a chrome-rimmed
     window, and three metal keys. Colours are set at runtime by DeckWidget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_body"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/widget_window"
            android:padding="4dp">

            <ImageView
                android:id="@+id/widget_cassette"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/ic_w_cassette"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Album art" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:text="FOLDMAN"
                android:textColor="#FFDCE6F2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="No tape"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open the deck"
                android:textColor="#FFDCE6F2"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="46dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_key"
                    android:contentDescription="Previous song"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_prev" />

                <ImageButton
                    android:id="@+id/widget_play"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_key_play"
                    android:contentDescription="Play or pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="46dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_key"
                    android:contentDescription="Next song"
                    android:scaleType="center"
                    android:src="@drawable/ic_w_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
