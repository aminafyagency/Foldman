<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome rim around a dark window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#FFF4F5F7" android:centerColor="#FF8C9096" android:endColor="#FFDADCDF" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FF0C0C0D" />
        </shape>
    </item>
</layer-list>
