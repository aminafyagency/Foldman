<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#FFC4501A" android:endColor="#FFA03E12" />
            <stroke android:width="1dp" android:color="#66000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#FFFF9A5C" android:centerColor="#FFF0722B" android:endColor="#FFC4501A" />
            <stroke android:width="1dp" android:color="#66000000" />
        </shape>
    </item>
</selector>
