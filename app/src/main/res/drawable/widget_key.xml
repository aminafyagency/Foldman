<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#FFB6B9BE" android:endColor="#FF8E9196" />
            <stroke android:width="1dp" android:color="#66000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="#FFF2F3F5" android:centerColor="#FFC3C5C9" android:endColor="#FF9EA1A6" />
            <stroke android:width="1dp" android:color="#66000000" />
        </shape>
    </item>
</selector>
